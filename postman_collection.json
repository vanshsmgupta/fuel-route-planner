{
  "info": {
    "name": "Fuel Route Planner",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "http://127.0.0.1:8000" }],
  "item": [
    {
      "name": "Plan route (GET)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": ["{{base_url}}"],
          "path": ["api", "route", ""],
          "query": [
            { "key": "start", "value": "New York, NY" },
            { "key": "finish", "value": "Los Angeles, CA" }
          ]
        }
      }
    },
    {
      "name": "Plan route (POST)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Houston, TX\"\n}" },
        "url": { "raw": "{{base_url}}/api/route/", "host": ["{{base_url}}"], "path": ["api", "route", ""] }
      }
    },
    {
      "name": "Route map (HTML)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/map/?start=Seattle, WA&finish=Miami, FL",
          "host": ["{{base_url}}"],
          "path": ["api", "route", "map", ""],
          "query": [
            { "key": "start", "value": "Seattle, WA" },
            { "key": "finish", "value": "Miami, FL" }
          ]
        }
      }
    }
  ]
}
